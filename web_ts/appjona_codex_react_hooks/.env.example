# Composer de autenticacion (src/services/authServiceComposer.ts).
# Copia este archivo a .env.local y ajusta los valores.

# Implementacion de InterAuthService: mock | real. Default: mock.
VITE_AUTH_MODE=mock

# Escenario del mock: exitoso | credencialesInvalidas | errorServidor. Default: exitoso.
VITE_AUTH_SCENARIO=exitoso

# URL base del backend. Obligatoria solo cuando VITE_AUTH_MODE=real (POST {url}/auth/login).
VITE_AUTH_API_URL=
