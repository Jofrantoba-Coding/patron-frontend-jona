# Service source: "mock" (in-browser mock services) or "http" (real HTTP API / mock-server)
VITE_API_MODE=mock
# Mock scenario (mock mode only): exitoso | vacio | errorServidor
VITE_API_SCENARIO=exitoso
# Base URL of the API (http mode only), e.g. the local mock server
VITE_API_URL=http://localhost:4020
