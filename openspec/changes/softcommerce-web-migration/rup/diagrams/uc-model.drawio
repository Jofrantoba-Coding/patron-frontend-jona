  <diagram id="uc-model" name="Modelo de casos de uso">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Modelo de casos de uso — SoftCommerce Web, ola 1" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Sistema: SoftCommerce Web (ola 1)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#566573;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="200" y="80" width="880" height="720" as="geometry"/></mxCell><mxCell id="c4" value="Usuario (operador)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="90" y="360" width="40" height="60" as="geometry"/></mxCell><mxCell id="c5" value="«system»&lt;br&gt;Servidor mock (API)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1160" y="360" width="40" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;CU-01&lt;/b&gt;&lt;br&gt;Iniciar sesión&lt;br&gt;(tenant + credenciales)" style="ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E86C1;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="240" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;CU-02&lt;/b&gt;&lt;br&gt;Seleccionar contexto de trabajo&lt;br&gt;(empresa, punto de venta, período)" style="ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E86C1;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="260" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;CU-03&lt;/b&gt;&lt;br&gt;Navegar menú y abrir formulario&lt;br&gt;(menú, permisos, pestañas)&lt;hr&gt;puntos de extensión:&lt;br&gt;&lt;i&gt;formulario abierto&lt;/i&gt;" style="ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E86C1;" vertex="1" parent="1"><mxGeometry x="250" y="320" width="270" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;CU-04&lt;/b&gt;&lt;br&gt;Mantener Localidad&lt;br&gt;(INSERT · UPDATE · DELETE lógico · DETAIL · CLONE)" style="ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E86C1;" vertex="1" parent="1"><mxGeometry x="240" y="560" width="290" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;CU-04a&lt;/b&gt;&lt;br&gt;Seleccionar Ubigeo en cascada" style="ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E86C1;" vertex="1" parent="1"><mxGeometry x="660" y="520" width="240" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;CU-04b&lt;/b&gt;&lt;br&gt;Seleccionar Empresa" style="ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E86C1;" vertex="1" parent="1"><mxGeometry x="660" y="660" width="240" height="80" as="geometry"/></mxCell><mxCell id="e12" value="" style="endArrow=none;html=1;strokeColor=#566573;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="endArrow=none;html=1;strokeColor=#566573;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="endArrow=none;html=1;strokeColor=#566573;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="endArrow=none;html=1;strokeColor=#566573;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="endArrow=none;html=1;strokeColor=#566573;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="endArrow=none;html=1;str