<?xml version="1.0" encoding="utf-8"?>
<!-- Declara nuget.org aquí para que el ejemplo no dependa de la configuración de NuGet de la máquina. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
