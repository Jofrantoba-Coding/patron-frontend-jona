{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // NodeNext: el BFF y los backends corren en Node tal como se compilan, sin empaquetador.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["src", "backends", "test", "arrancar.ts", "vitest.config.ts"],
  // Los árboles de test/fixtures contienen violaciones a propósito: se analizan, no se compilan.
  "exclude": ["test/fixtures"]
}
