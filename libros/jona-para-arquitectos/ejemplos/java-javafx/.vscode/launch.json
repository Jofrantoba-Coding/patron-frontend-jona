{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "request": "launch",
      "name": "JavaFX: servicio falso",
      "projectName": "jona-ejemplo-java-javafx",
      "mainClass": "com.example.App",
      "args": "--fake",
      "modulePaths": [
        "$Auto",
        "${userHome}/.m2/repository/org/openjfx/javafx-base/21.0.6",
        "${userHome}/.m2/repository/org/openjfx/javafx-graphics/21.0.6",
        "${userHome}/.m2/repository/org/openjfx/javafx-controls/21.0.6"
      ],
      "vmArgs": "--add-modules javafx.controls"
    },
    {
      "type": "java",
      "request": "launch",
      "name": "JavaFX: solo la Plantilla",
      "projectName": "jona-ejemplo-java-javafx",
      "mainClass": "com.example.App",
      "args": "--plantilla",
      "modulePaths": [
        "$Auto",
        "${userHome}/.m2/repository/org/openjfx/javafx-base/21.0.6",
        "${userHome}/.m2/repository/org/openjfx/javafx-graphics/21.0.6",
        "${userHome}/.m2/repository/org/openjfx/javafx-controls/21.0.6"
      ],
      "vmArgs": "--add-modules javafx.controls"
    },
    {
      "type": "java",
      "request": "launch",
      "name": "JavaFX: servidor mock",
      "projectName": "jona-ejemplo-java-javafx",
      "mainClass": "com.example.App",
      "modulePaths": [
        "$Auto",
        "${userHome}/.m2/repository/org/openjfx/javafx-base/21.0.6",
        "${userHome}/.m2/repository/org/openjfx/javafx-graphics/21.0.6",
        "${userHome}/.m2/repository/org/openjfx/javafx-controls/21.0.6"
      ],
      "vmArgs": "--add-modules javafx.controls"
    },
    {
      "type": "java",
      "request": "launch",
      "name": "JavaFX: backend real",
      "projectName": "jona-ejemplo-java-javafx",
      "mainClass": "com.example.App",
      "args": "${input:urlBackend}",
      "modulePaths": [
        "$Auto",
        "${userHome}/.m2/repository/org/openjfx/javafx-base/21.0.6",
        "${userHome}/.m2/repository/org/openjfx/javafx-graphics/21.0.6",
        "${userHome}/.m2/repository/org/openjfx/javafx-controls/21.0.6"
      ],
      "vmArgs": "--add-modules javafx.controls"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Servidor mock",
      "program": "${workspaceFolder}/../mock-server/src/server.mjs",
      "env": {
        "MOCK_SCENARIO": "${input:escenarioMock}"
      },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "JavaFX + servidor mock",
      "configurations": ["Servidor mock", "JavaFX: servidor mock"],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "urlBackend",
      "type": "promptString",
      "description": "URL base del backend",
      "default": "https://backend.example.com"
    },
    {
      "id": "escenarioMock",
      "type": "pickString",
      "description": "Escenario por defecto del servidor mock",
      "options": ["exitoso", "credencialesInvalidas", "usuarioBloqueado", "errorServidor"],
      "default": "exitoso"
    }
  ]
}
