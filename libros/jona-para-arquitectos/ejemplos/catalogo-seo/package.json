{
  "name": "jona-ejemplo-catalogo-seo",
  "version": "1.0.0",
  "private": true,
  "description": "SEO desde tres lugares: el sistema de diseño, un sitio estático prerenderizado y un servidor SSR, con el mismo código y una sola auditoría (capítulo 16)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --ssr --outDir dist/server && node dist/server/generarEstatico.js",
    "start": "node dist/server/principal.js",
    "preview:estatico": "node dist/server/previsualizarEstatico.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@jona-libro/ds-atomico": "file:../sistema-diseno-atomico",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
