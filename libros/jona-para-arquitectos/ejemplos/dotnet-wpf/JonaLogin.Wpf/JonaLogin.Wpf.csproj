<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vista y entrada en WPF. Solo compila y se ejecuta en Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JonaLogin.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JonaLogin.Core\JonaLogin.Core.csproj" />
  </ItemGroup>

</Project>
