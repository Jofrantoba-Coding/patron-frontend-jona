<!-- UiLoginView.xaml: vista. Solo enlaza el contrato InterUiLogin (DataContext). -->
<UserControl x:Class="JonaLogin.Wpf.UiLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="16" Width="280">
    <TextBlock Text="Iniciar sesión" FontSize="20" Margin="0,0,0,12" />
    <TextBlock Text="Correo" />
    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
             IsEnabled="{Binding IsSubmitting, Converter={StaticResource Not}}" />
    <TextBlock Text="Contraseña" Margin="0,8,0,0" />
    <PasswordBox x:Name="passwordBox" PasswordChanged="OnPasswordChanged"
                 IsEnabled="{Binding IsSubmitting, Converter={StaticResource Not}}" />
    <TextBlock Text="{Binding Error}" Foreground="Firebrick" Margin="0,8,0,0" TextWrapping="Wrap" />
    <Button Content="Ingresar" Command="{Binding SubmitCommand}" IsDefault="True" Margin="0,12,0,0" />
  </StackPanel>
</UserControl>
