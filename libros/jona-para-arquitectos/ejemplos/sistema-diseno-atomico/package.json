{
  "name": "@jona-libro/ds-atomico",
  "version": "1.2.0",
  "private": true,
  "description": "Sistema de diseño con Atomic Design y JONA, construido nivel por nivel (capítulo 13)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tema/tokens.css"
  },
  "files": [
    "dist",
    "src/tema/tokens.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "axe-core": "4.11.4",
    "jsdom": "26.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
